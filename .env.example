# Postgres. Production: Neon (region aws-ap-southeast-1 / Singapore), pooled connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/site_monitoring
DATABASE_POOL_MAX=10

# Public URL of this app (used in snippets, alert links, MCP config). Use *.vercel.app or a non-Cloudflare domain.
APP_URL=http://localhost:3000

# Encrypts ingest-key secrets at rest (≥16 chars). Changing it invalidates existing keys.
KEY_ENCRYPTION_SECRET=change-me-to-a-long-random-string

# Only e-mails of this domain can register / sign in (empty = any domain)
ALLOWED_EMAIL_DOMAIN=siroby.com
# "false" = disable self sign-up after the first account exists
ALLOW_REGISTRATION=true

# Alert e-mails via Resend — use a key dedicated to this webapp, NOT the app's key
RESEND_API_KEY=
ALERT_FROM_EMAIL="Site Monitoring <alerts@example.com>"

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup
CRON_SECRET=change-me
